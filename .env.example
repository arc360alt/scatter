# Cloud sync is optional - Scatter works fully local-first without any of this set.
# See the "Cloud sync setup" section in README.md for the full walkthrough.
#
# Uses Supabase's newer key format (sb_publishable_.../sb_secret_...), not the older
# anon/service_role JWTs - same createClient() API, just get these from Project
# Settings > API Keys instead.

# Client-safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only - used exclusively by api/delete-account.ts. Never prefix this with
# VITE_ (that would bundle it into client code) and never commit a real value.
SUPABASE_SECRET_KEY=
